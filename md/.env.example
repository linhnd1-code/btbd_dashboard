# FILE MẪU BIẾN MÔI TRƯỜNG
# Hãy copy file này và đổi tên thành ".env" sau đó điền mật khẩu thật vào. 
# Tuyệt đối không commit file ".env" lên Git!

# ================= BACKEND (Python) =================
ENVIRONMENT=development
PORT=8000

# Kết nối Database (PostgreSQL) — BỎ TRỐNG/comment dòng dưới để dùng SQLite mặc định lúc dev
# (xem core/database.py). Chỉ điền connection string thật khi dùng Postgres (Production, hoặc
# test Postgres tại local).
# DATABASE_URL="postgresql://user:password@localhost:5432/my_internal_db"

# Khóa bảo mật để mã hóa Token đăng nhập
SECRET_KEY="Dien-Mot-Doan-Ma-Kho-Doan-Vao-Day"


# ================= FRONTEND (React) =================
# URL của máy chủ Backend để React gọi API (Chú ý: Vite bắt buộc dùng tiền tố VITE_)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
